# ── 텔레그램 ──────────────────────────────────────────────
# @BotFather 에서 받은 토큰
TELEGRAM_BOT_TOKEN=
# 봇을 쓸 수 있는 텔레그램 사용자 ID (쉼표로 여러 명). 모르면 비워 두고
# 봇에게 /start 를 보내면 ID 를 알려 줍니다.
ALLOWED_USER_IDS=

# ── 코레일 계정 ───────────────────────────────────────────
# 회원번호 / 휴대폰번호 / 이메일 중 하나
KORAIL_MEMBER_NO=
KORAIL_PASSWORD=

# ── 웹훅 (Caddy → localhost:8000) ────────────────────────
# 비워 두면 롱폴링으로 동작합니다.
WEBHOOK_BASE_URL=https://korailbotkorailbot.duckdns.org
WEBHOOK_PATH=telegram
# 텔레그램이 X-Telegram-Bot-Api-Secret-Token 헤더로 보내는 값 (영문/숫자/_/- 1~256자)
# 생성 예: openssl rand -hex 32
WEBHOOK_SECRET=
LISTEN_HOST=0.0.0.0
LISTEN_PORT=8000

# ── 자동 예약 ─────────────────────────────────────────────
# 조회 간격(초) = MACRO_INTERVAL_SECONDS + 0~MACRO_JITTER_SECONDS 무작위.
# 너무 짧게 잡으면 코레일에서 차단될 수 있습니다.
MACRO_INTERVAL_SECONDS=3
MACRO_JITTER_SECONDS=2
# 연속 오류가 이만큼 나면 중단
MACRO_MAX_ERRORS=20
# 한 작업의 최대 실행 시간(시간)
MACRO_MAX_HOURS=24
# SRT 열차도 함께 조회 (KORAIL·SR 통합 이후)
INCLUDE_SRT=true

# ── (선택) 기기 신원 고정 ─────────────────────────────────
# 비워 두면 실행할 때마다 합성 기기 값을 씁니다. 실제 기기 값을 넣으면
# 재시작해도 같은 기기로 보입니다. 셋 다 넣어야 적용됩니다.
# KORAIL_DYNAPATH_DEVICE_ID=0123456789abcdef
# KORAIL_DYNAPATH_OS_VERSION=15
# KORAIL_DYNAPATH_DEVICE_MODEL=SM-S928N

LOG_LEVEL=INFO
